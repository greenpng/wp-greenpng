<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="GreenPNGCompat">
    <description>PHP 7.4 compatibility gate (AGENTS §3.3 check #3). Wraps PHPCompatibilityWP so the standard resolves without relying on the dealerdirect plugin successfully writing CodeSniffer.conf (observed to fail locally).</description>

    <!-- Same hygiene as the main ruleset: only our own PHP is scanned.
         Vendored third-party assets (minified chart library, data files)
         are not our source and would only produce noise warnings. -->
    <exclude-pattern>*/assets/*</exclude-pattern>
    <arg name="extensions" value="php"/>

    <config name="installed_paths" value="../../wp-coding-standards/wpcs,../../phpcompatibility/php-compatibility,../../phpcompatibility/phpcompatibility-wp,../../phpcompatibility/phpcompatibility-paragonie,../../phpcsstandards/phpcsutils"/>

    <rule ref="PHPCompatibilityWP"/>
</ruleset>
