<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="greenpng">
            <!-- Explicit suffix: the directory also carries non-test
                 support scripts (process-isolation children), which
                 must never be included as candidate test classes. -->
            <directory suffix="Test.php">tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
